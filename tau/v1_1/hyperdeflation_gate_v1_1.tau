# Alignment Theorem V1.1: finite hyperdeflation eligibility gate.
#
# The host is expected to derive strict_hyperdeflation_margin from bounded
# integer arithmetic. All four inputs remain assumed propositions at this Tau
# boundary; this packet does not authenticate them or grant publication or
# value-moving authority. The conjunction is false unless every proposition is
# true. See docs/v1-1-hyperdeflationary-alignment.html.

eetf_authenticated:sbf := in file("inputs/eetf_authenticated.in").
action_ethical:sbf := in file("inputs/action_ethical.in").
strict_hyperdeflation_margin:sbf := in file("inputs/strict_hyperdeflation_margin.in").
reward_funded:sbf := in file("inputs/reward_funded.in").

reference_eligible:sbf := out file("outputs/reference_eligible.out").

defs
r (
    reference_eligible[t] = (
        eetf_authenticated[t]
        & action_ethical[t]
        & strict_hyperdeflation_margin[t]
        & reward_funded[t]
    )
)
q
